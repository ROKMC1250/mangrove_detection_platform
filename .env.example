# ============================================================
# EarthScope — deployment configuration
#
# Copy this file to `.env` and edit the values for your own
# Google Cloud / Earth Engine project. This is the only file
# you need to change to run EarthScope on your own machine.
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit it, and never commit your
# service account key.
#
# Keep comments on their own lines (this file is read by
# run.sh, run.bat and python-dotenv alike).
# ============================================================


# --- Earth Engine (required) -------------------------------
# Path to your Google Earth Engine service account JSON key.
# Relative paths are resolved against the project root.
EE_SERVICE_ACCOUNT_KEY=backend/ee-service-account-key.json

# Service account address. Leave empty to read `client_email`
# straight out of the key file above (recommended).
EE_SERVICE_ACCOUNT=


# --- Google Cloud Storage (optional) -----------------------
# Only needed for server-side GeoTIFF export of large AOIs
# (bigger than the direct-download limit). Leave GCS_BUCKET
# empty to disable that export path; everything else still works.
GCS_BUCKET=
GCS_BUCKET_REGION=asia-northeast3


# --- Model checkpoints (optional) --------------------------
# Directory holding the SAM3 checkpoints. Defaults to repo/sam3.
SAM3_CHECKPOINT_DIR=repo/sam3

# Explicit path to the SAM3 BPE vocabulary. Leave empty to let
# the sam3 package resolve its own bundled asset.
SAM3_BPE_PATH=

# Root of the segmentation model source tree. Leave empty to use
# the bundled repo/mangrove_segmentation.
MODEL_ROOT=

# Root directory scanned in local mode for band-registration
# experiment results. Relative paths resolve against the project root.
LOCAL_BASE_DIR=experiment_results


# --- Performance tuning (optional) -------------------------
# HTTP connection pool size used for Earth Engine tile downloads.
HTTP_POOL=32

# Number of parallel workers used when downloading and mosaicking tiles.
PARALLEL_TILE_WORKERS=6
