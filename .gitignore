# ===== Credentials — never commit =====
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/ee-service-account-key.json
*service-account*.json
*-key.json
*.pem
*.p12

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
venv/
env/
ENV/
.venv/

# ===== Runtime output & logs =====
outputs/
.outputs/
logs/
*.log

# ===== Local documentation & internal material (not published) =====
docs/
frontend/Telepix_design/

# ===== Editor / tooling state =====
.vscode/
.claude/
.agents/
.codex/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.bat.bak
*.swp
*.swo
*~

# ===== Model weights & large media =====
# Checkpoints already committed through Git LFS stay tracked despite these rules.
*.pt
*.pth
# The demo video ships as a GitHub Release asset, not as a repo file.
*.mp4
*.mov

# ===== Imagery & generated rasters =====
*.tif
*.tiff
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.svg
*.ico

# ===== ...but the app's own UI assets must ship =====
!frontend/assets/logo/
!frontend/assets/logo/*

target_detector.py
